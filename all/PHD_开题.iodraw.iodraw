        <mxCell id="a1F_uhm3ZJby7PDIXVdp-97" value="效果验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
