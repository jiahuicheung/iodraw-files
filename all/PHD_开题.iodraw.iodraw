        <mxCell id="a1F_uhm3ZJby7PDIXVdp-98" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;研究内容一&lt;/b&gt;&lt;/div&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;· 当前情况相对同等工况偏离了多少&lt;br style=&quot;font-size: 16px;&quot;&gt;· 由哪些因子承载&lt;br style=&quot;font-size: 16px;&quot;&gt;· 更像哪类风险&lt;br style=&quot;font-size: 16px;&quot;&gt;· 结论有多可信&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;i style=&quot;font-size: 16px;&quot;&gt;输出：风险约束与优先级&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1476" y="-588" width="300" height="186" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-99" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;研究内容二&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;· 系统整体有多严重&lt;br style=&quot;font-size: 16px;&quot;&gt;· 由什么因素驱动&lt;br style=&quot;font-size: 16px;&quot;&gt;· 还剩多少安全裕度&lt;br style=&quot;font-size: 16px;&quot;&gt;· 哪个因子对结论影响最大&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;i style=&quot;font-size: 16px;&quot;&gt;输出：控制约束与优先级&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1811" y="-588" width="300" height="186" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-100" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;研究内容三&lt;/b&gt;&lt;/div&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;· 面向不同控制对象建立模型&lt;br style=&quot;font-size: 16px;&quot;&gt;· 风险发生后对象还能不能控&lt;br style=&quot;font-size: 16px;&quot;&gt;· 怎么控&lt;br style=&quot;font-size: 16px;&quot;&gt;· 把评估结论转化为可执行动作&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;i style=&quot;font-size: 16px;&quot;&gt;输出：控制介入动作与退出触发&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2146" y="-588" width="300" height="186" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-101" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;研究内容四&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;·&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;结论在什么条件下成立&lt;/span&gt;&lt;div&gt;· 能支持到哪一级&lt;br style=&quot;font-size: 16px;&quot;&gt;· 对前建立的模型、参数与边界进行检验&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;i style=&quot;font-size: 16px;&quot;&gt;输出：适用条件与支持等级&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
