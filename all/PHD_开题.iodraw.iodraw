        <mxCell id="a1F_uhm3ZJby7PDIXVdp-151" value="&lt;span style=&quot;font-size: 15px;&quot;&gt;问题一　&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;复杂工况下风险状态的可辨识性&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B85450;fontSize=15;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
