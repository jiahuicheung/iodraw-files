        <mxCell id="a1F_uhm3ZJby7PDIXVdp-154" value="&lt;span style=&quot;font-size: 15px;&quot;&gt;问题四　&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;风险工况下的可控性与处置边界&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B85450;fontSize=15;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="3235" y="-415" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-155" value="&lt;div style=&quot;text-align: center; font-size: 15px;&quot;&gt;&lt;b style=&quot;background-color: initial; font-size: 15px;&quot;&gt;研究内容一　风险识别模型&lt;/b&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;分别回答问题一、问题二：把“阈值判据”替换为“工况自适应的偏离度量 + 可信度输出”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=15;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="3570" y="-644" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-156" value="&lt;div style=&quot;text-align: center; font-size: 15px;&quot;&gt;&lt;b style=&quot;background-color: initial; font-size: 15px;&quot;&gt;研究内容二　系统综合风险评估&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;回答问题三：避免重复计入导致的综合值放大与真实风险掩盖&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=15;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="3570" y="-545" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-157" value="&lt;div style=&quot;text-align: center; font-size: 15px;&quot;&gt;&lt;b style=&quot;background-color: initial; font-size: 15px;&quot;&gt;研究内容三　风险工况适配控制&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;回答问题四：把“何时必须转为人工接管”给出可判定依据&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=15;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="3570" y="-445" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-158" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#B85450;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-151">
