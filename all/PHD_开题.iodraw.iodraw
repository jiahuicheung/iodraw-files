        <mxCell id="a1F_uhm3ZJby7PDIXVdp-211" value="图2.3.2　多源风险融合与综合风险状态评估：研究内容及子内容逻辑关系" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2430" y="970" width="1440" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-213" value="&lt;b&gt;研究目标&lt;/b&gt;：建立&lt;b&gt;共因不重复、非补偿&lt;/b&gt;的系统风险合成方法，使合成结果能够分解并追溯到具体风险因子乃至原始观测值；在此基础上分析各因子对综合结果的敏感程度，识别关键因子及其敏感区间；最终形成包含&lt;b&gt;风险等级、画像判定和可信度&lt;/b&gt;的综合风险评估结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="2430" y="1028" width="1440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-214" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2430" y="1154" width="1440" height="300" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-215" value="&lt;b&gt;（1）综合风险状态评估&lt;/b&gt;——底层观测、中层因子、顶层系统风险三层指标体系；合成环节处理共因重复计量与非补偿性两个问题" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2F5C8A;" vertex="1" parent="1">
          <mxGeometry x="2446" y="1160" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-216" value="&lt;b&gt;① 三层指标体系&lt;/b&gt;&lt;br&gt;&lt;br&gt;底层观测 → 中层因子 → 顶层系统风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="2454" y="1210" width="264" height="220" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-217" value="&lt;b&gt;② 统一表达与边界归一化&lt;/b&gt;&lt;br&gt;&lt;br&gt;连续量 + 工况条件 → &lt;b&gt;标准化偏移 / 条件分位&lt;/b&gt;&lt;br&gt;&lt;br&gt;有明确工程边界的量 → &lt;b&gt;归一化安全裕度&lt;/b&gt;&lt;br&gt;&lt;br&gt;边界取自设计参数、运行规范或经验证试验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="2742" y="1210" width="264" height="220" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-218" value="&lt;b&gt;③ 共因归并&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一股风对多项指标的同时作用 → 归并为&lt;b&gt;单一环境胁迫项&lt;/b&gt;&lt;br&gt;&lt;br&gt;再对&lt;b&gt;因子特异分量&lt;/b&gt;计权&lt;br&gt;&lt;br&gt;避免同一风险触发因素被重复计量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="3030" y="1210" width="264" height="220" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-219" value="&lt;b&gt;④ 非补偿聚合&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;任一裕度趋零 → 综合风险趋于上界&lt;/b&gt;&lt;br&gt;&lt;br&gt;因子之间不得相互补偿&lt;br&gt;&lt;br&gt;给出线性加权失效的典型反例及其在真实数据中的出现情形" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="3318" y="1210" width="264" height="220" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-220" value="&lt;b&gt;⑤ 可解释输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;· 风险等级&lt;br&gt;· 主要贡献因子&lt;br&gt;· 可信度&lt;br&gt;· 可能的短期趋势提示&lt;br&gt;&lt;br&gt;合成结果可分解、可追溯至原始观测值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#1F6FB2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="3606" y="1210" width="264" height="220" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-221" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6C8EBF;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-216" target="a1F_uhm3ZJby7PDIXVdp-217">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6C8EBF;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-217" target="a1F_uhm3ZJby7PDIXVdp-218">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-223" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6C8EBF;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-218" target="a1F_uhm3ZJby7PDIXVdp-219">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-224" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6C8EBF;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-219" target="a1F_uhm3ZJby7PDIXVdp-220">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-225" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FA;strokeColor=#9673A6;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2430" y="1502" width="700" height="340" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-226" value="&lt;b&gt;（2）风险因子的敏感性分析&lt;/b&gt;——哪些因子更容易影响综合评估结果" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6B4A8A;" vertex="1" parent="1">
          <mxGeometry x="2446" y="1508" width="660" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-227" value="&lt;b&gt;① 扰动对象与方式&lt;/b&gt;：合成模型确定后，对因子施加系统扰动，考察其对风险等级、综合风险值和最薄弱裕度的影响；&lt;b&gt;局部&lt;/b&gt;刻画当前工作点附近的响应，&lt;b&gt;全局&lt;/b&gt;刻画整个取值域内的贡献" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1552" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-228" value="&lt;b&gt;② 共因分解后对残差度量&lt;/b&gt;：先条件化共同环境驱动，再对残差度量敏感性，避免把同一股风的作用重复计为多个高敏感因子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1620" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-229" value="&lt;b&gt;③ 敏感区间与分层图谱&lt;/b&gt;：非补偿聚合下&lt;b&gt;敏感性不是常数&lt;/b&gt;——裕度接近边界时陡增；同一因子在不同工况、不同风险等级下排序不同，因此不以单一排序给出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1688" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-230" value="&lt;b&gt;④ 输出&lt;/b&gt;：因子敏感性排序、敏感区间、交互效应、分层敏感性图谱；&lt;b&gt;关键少数因子清单&lt;/b&gt; → 为研究内容三确定调节与监测的优先顺序提供依据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8F7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1756" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-231" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FA;strokeColor=#9673A6;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="3170" y="1502" width="700" height="340" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-232" value="&lt;b&gt;（3）综合风险评估的动态预测&lt;/b&gt;——当前评估只反映当前时刻，而风险处置需要提前量" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6B4A8A;" vertex="1" parent="1">
          <mxGeometry x="3186" y="1508" width="660" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-233" value="&lt;b&gt;① 输入&lt;/b&gt;：多源时序数据 + 工况条件 + 已识别的&lt;b&gt;关键敏感因子&lt;/b&gt;；兼顾缓慢累积与短时冲击两类演化，不同因子可预测性差异明显" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3200" y="1552" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-234" value="&lt;b&gt;② 约束&lt;/b&gt;：以工程边界和因子间共因关系作为约束，避免预测结果越过物理上不可达的状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3200" y="1620" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-235" value="&lt;b&gt;③ 误差与可信度分析&lt;/b&gt;：针对小样本与工况切换，分析预测误差随&lt;b&gt;预测步长 × 工况稳定程度 × 样本覆盖&lt;/b&gt;的变化，给出预测可信度的判别条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3200" y="1688" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-236" value="&lt;b&gt;④ 输出&lt;/b&gt;：未来短时风险等级、趋势提示及预测可信度 → 为后续控制决策中的&lt;b&gt;处置时机判断&lt;/b&gt;提供输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8F7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="3200" y="1756" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-237" value="合成模型为敏感性分析的扰动对象" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#1F6FB2;fontSize=10;fontColor=#1F6FB2;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-214" target="a1F_uhm3ZJby7PDIXVdp-225">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-238" value="综合风险状态序列为预测提供基准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.68;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#1F6FB2;fontSize=10;fontColor=#1F6FB2;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-214" target="a1F_uhm3ZJby7PDIXVdp-231">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3409" y="1482" />
              <mxPoint x="3394" y="1482" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-239" value="关键敏感因子" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673A6;fontSize=10;fontColor=#6B4A8A;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-225" target="a1F_uhm3ZJby7PDIXVdp-231">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-240" value="敏感区间与共因结构回修聚合权重、边界设定与指标体系" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.12;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#C0392B;dashed=1;fontSize=10;fontColor=#C0392B;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-225" target="a1F_uhm3ZJby7PDIXVdp-214">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-241" value="预测可信度判别条件回馈综合评估的可信度与趋势提示" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.88;exitY=0;exitDx=0;exitDy=0;entryX=0.88;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#C0392B;dashed=1;fontSize=10;fontColor=#C0392B;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-231" target="a1F_uhm3ZJby7PDIXVdp-214">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-242" value="&lt;b&gt;输出至 2.3.3 风险工况适配控制&lt;/b&gt;：风险等级 · 主要贡献因子 · 画像判定 · 可信度 · 关键敏感因子与敏感区间 · 未来短时趋势提示与预测可信度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="2430" y="1874" width="1440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-243" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82B366;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-230" target="a1F_uhm3ZJby7PDIXVdp-242">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2780" y="1852" />
              <mxPoint x="3150" y="1852" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a1F_uhm3ZJby7PDIXVdp-244" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82B366;" edge="1" parent="1" source="a1F_uhm3ZJby7PDIXVdp-236" target="a1F_uhm3ZJby7PDIXVdp-242">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3520" y="1852" />
              <mxPoint x="3150" y="1852" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
